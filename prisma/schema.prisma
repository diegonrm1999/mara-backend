generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id              String @id @default(uuid())
  name            String
  publicApiKey    String @unique @default(uuid()) // Key for frontend public access
  lastOrderNumber Int    @default(0)

  users               User[]
  clients             Client[]
  treatments          Treatment[]
  treatmentCategories TreatmentCategory[]
  orders              Order[]
  scheduledOrders     ScheduledOrder[]
  userSchedules       UserSchedule[]
  productCategories   ProductCategory[]
  products            Product[]
  productVariants     ProductVariant[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model User {
  id        String  @id @default(uuid())
  email     String? @unique
  password  String?
  role      Role
  firstName String
  lastName  String

  stylistOrders    Order[] @relation("StylistUser")
  cashierOrders    Order[] @relation("CashierUser")
  supervisorOrders Order[] @relation("SupervisorUser")

  treatments              UserTreatment[]
  schedules               UserSchedule[]
  scheduleExceptions      UserScheduleException[]
  createdScheduledOrders  ScheduledOrder[]        @relation("ScheduledOrderCreator")
  assignedScheduledOrders ScheduledOrder[]        @relation("ScheduledOrderStylist")

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Client {
  id        String  @id @default(uuid())
  dni       String  @unique
  firstName String
  lastName  String
  phone     String?
  email     String?

  orders          Order[]
  scheduledOrders ScheduledOrder[]

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId, firstName, lastName], name: "clients_shop_name")
}

model TreatmentCategory {
  id           String @id @default(uuid())
  name         String
  displayOrder Int    @default(0)

  treatments Treatment[]

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([shopId, name])
}

model Treatment {
  id          String  @id @default(uuid())
  name        String
  description String?
  percentage  Float
  basePrice   Float?

  categoryId String?
  category   TreatmentCategory? @relation(fields: [categoryId], references: [id])

  orderTreatments          OrderTreatment[]
  scheduledOrderTreatments ScheduledOrderTreatment[]
  userTreatments           UserTreatment[]

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserTreatment {
  id          String @id @default(uuid())
  userId      String
  treatmentId String

  user      User      @relation(fields: [userId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, treatmentId])
}

model UserSchedule {
  id        String @id @default(uuid())
  userId    String
  shopId    String
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayOfWeek])
}

model UserScheduleException {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  date      DateTime
  type      ScheduleExceptionType
  startTime String?
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model OrderTreatment {
  id          String @id @default(uuid())
  orderId     String
  treatmentId String
  price       Float

  order     Order     @relation(fields: [orderId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(uuid())

  stylistId String
  stylist   User   @relation("StylistUser", fields: [stylistId], references: [id])

  supervisorId String
  supervisor   User   @relation("SupervisorUser", fields: [supervisorId], references: [id])

  cashierId String
  cashier   User   @relation("CashierUser", fields: [cashierId], references: [id])

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  treatments      OrderTreatment[]
  totalPrice      Float
  stylistEarnings Float            @default(0)

  paidAmount    Float?
  paymentMethod PaymentMethod?
  status        OrderStatus    @default(Created)
  orderNumber   Int
  ticketNumber  String?

  scheduledOrder ScheduledOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, orderNumber])
  @@index([shopId, createdAt(sort: Desc)], name: "orders_shop_date")
  @@index([shopId, status], name: "orders_shop_status")
  @@index([shopId, stylistId], name: "orders_shop_stylist")
  @@index([shopId, supervisorId], name: "orders_shop_supervisor")
  @@index([shopId, cashierId], name: "orders_shop_cashier")
}

model ScheduledOrder {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  contactName  String
  contactPhone String
  contactEmail String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  stylistId String?
  stylist   User?   @relation("ScheduledOrderStylist", fields: [stylistId], references: [id])

  createdById String?
  createdBy   User?                @relation("ScheduledOrderCreator", fields: [createdById], references: [id])
  source      ScheduledOrderSource @default(Web)

  scheduledAt     DateTime
  durationMinutes Int

  treatments ScheduledOrderTreatment[]

  status ScheduledOrderStatus @default(Pending)
  notes  String?

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId, scheduledAt], name: "scheduled_orders_shop_date")
  @@index([shopId, status], name: "scheduled_orders_shop_status")
  @@index([shopId, stylistId], name: "scheduled_orders_shop_stylist")
}

model ScheduledOrderTreatment {
  id               String @id @default(uuid())
  scheduledOrderId String
  treatmentId      String

  scheduledOrder ScheduledOrder @relation(fields: [scheduledOrderId], references: [id])
  treatment      Treatment      @relation(fields: [treatmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  id           String @id @default(uuid())
  name         String
  displayOrder Int    @default(0)

  products Product[]

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([shopId, name])
}

// A Product is the "parent" that groups the shared name/description/category.
// It is never sold directly — every Product has at least one ProductVariant,
// which is the actual purchasable/stocked/priced/photographed unit. This keeps
// a single shape for "sellable thing" (ProductVariant) for the future cart,
// instead of branching between "simple products" and "products with variants".
model Product {
  id           String  @id @default(uuid())
  name         String
  description  String?
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId, categoryId, displayOrder])
  @@index([shopId, active])
}

// The sellable unit: a specific SKU/variant of a Product (e.g. a color or
// size). Image URL is intentionally NOT stored here — it is derived from
// `id` following the fixed CDN convention (see products image util).
model ProductVariant {
  id         String  @id @default(uuid())
  sku        String?
  // Free-form variant attributes, e.g. { "color": "Rojo", "size": "M" }.
  attributes Json?

  price    Float
  currency String @default("PEN")

  // Available stock is `stock - reservedStock`. `reservedStock` is not used
  // yet (no cart/checkout in this phase) but is added now so a future cart
  // reservation flow only needs to start writing to it, not migrate for it.
  stock         Int @default(0)
  reservedStock Int @default(0)

  active       Boolean @default(true)
  displayOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Denormalized from product.shopId (same convention as Order/Client) so
  // shop-scoped stock/catalog queries never need to join through Product.
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([shopId, sku])
  @@index([productId])
  @@index([shopId, active])
}

enum Role {
  Stylist
  Cashier
  Supervisor
  Admin
}

enum OrderStatus {
  Created
  Claimed
  Completed
  Cancelled
}

enum PaymentMethod {
  Cash
  Yape
  Card
}

enum ScheduledOrderStatus {
  Pending
  Confirmed
  Cancelled
  NoShow
  Completed
}

enum ScheduledOrderSource {
  Web
  Internal
}

enum ScheduleExceptionType {
  DayOff
  CustomHours
}
